<?xml version="1.0" encoding="utf-8"?>
<!--
  Every size in the app. The old code used raw pixels, so nothing landed on a grid:
  48px of padding next to 24px above a label and 4px below it.

  The rule these encode: space between groups is always greater than space within one.
-->
<resources>
    <!-- the only spacing values that exist -->
    <dimen name="space_4">4dp</dimen>
    <dimen name="space_8">8dp</dimen>
    <dimen name="space_12">12dp</dimen>
    <dimen name="space_16">16dp</dimen>
    <dimen name="space_24">24dp</dimen>
    <dimen name="space_32">32dp</dimen>

    <!-- layout -->
    <dimen name="gutter">16dp</dimen>
    <dimen name="row_gap">8dp</dimen>
    <dimen name="section_top">24dp</dimen>
    <dimen name="section_bottom">8dp</dimen>

    <!-- nothing is below touch_min -->
    <dimen name="touch_min">48dp</dimen>
    <dimen name="row_height">72dp</dimen>
    <dimen name="button_height">56dp</dimen>
    <dimen name="thumb">48dp</dimen>
    <dimen name="corner">14dp</dimen>
    <dimen name="corner_large">20dp</dimen>

    <!-- three type sizes, and no others -->
    <dimen name="text_title">20sp</dimen>
    <dimen name="text_row">15sp</dimen>
    <dimen name="text_secondary">13sp</dimen>

    <!-- the dock. Keys are 52dp tall (above the 48dp minimum) and 56dp wide so "No-Tap"
         fits at the secondary type size without a fourth size being invented. -->
    <dimen name="dock_key_h">52dp</dimen>
    <dimen name="dock_key_w">56dp</dimen>
    <dimen name="dock_grip_w">20dp</dimen>
    <dimen name="dock_glyph">17sp</dimen>
</resources>
